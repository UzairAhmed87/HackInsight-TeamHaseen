# OpenAQ API key (free: https://explore.openaq.org/register). Needed for the first `make data`
# and every hourly run; also add it as the OPENAQ_API_KEY GitHub Actions secret.
# OPENAQ_API_KEY=
#
# Optional generative explanations in the Insight Agent (pick one):
# GEMINI_API_KEY=
# GROQ_API_KEY=
# LLM_API_KEY=  LLM_API_BASE=  LLM_MODEL=     # any OpenAI-compatible endpoint
#
# Optional: record hourly runs in Prefect Cloud as well as prefect_runs.csv
# PREFECT_API_URL=
# PREFECT_API_KEY=
#
# Optional: disable live AirGradient calls in the dashboard (offline demos/tests)
# HACKINSIGHT_DISABLE_LIVE=1
#
# Do not commit real secrets.
